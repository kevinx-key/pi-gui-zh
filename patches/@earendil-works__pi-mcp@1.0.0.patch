+function killWindowsProcessTree(pid) {
+    // Full path: the host's PATH is not guaranteed to contain System32, and a bare name can resolve to a shim.
+    // Resolves once taskkill is done; failures are logged, never thrown, since the caller is already closing.
+    const taskkill = path.join(process.env.SystemRoot ?? "C:\\Windows", "System32", "taskkill.exe");
+    return new Promise((resolve) => {
+        const killer = spawn(taskkill, ["/pid", String(pid), "/T", "/F"], { stdio: "ignore", windowsHide: true });
+        killer.on("error", (error) => {
+            console.warn(`[pi-mcp] failed to kill process tree of pid ${pid}: ${error.message}`);
+            resolve();
+        });
+        killer.on("close", (code) => {
+            if (code !== 0)
+                console.warn(`[pi-mcp] taskkill exited with code ${code} for pid ${pid}`);
+            resolve();
+        });
+    });
